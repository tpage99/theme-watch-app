<%# Shown in place of page data when a shopinfo.app call fails. `message` is the
    plain-language copy set by ApplicationController's rescue_from handlers. %>
<div class="rounded-xl border border-amber-500/20 bg-amber-500/[0.04] p-6" role="alert">
  <h2 class="text-base font-semibold text-amber-300"><%= title %></h2>
  <p class="mt-2 text-sm text-white/55"><%= message %></p>
</div>
